<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
 <PreferenceCategory app:title="@string/settings_appearance">
  <moe.matsuri.nb4a.ui.ColorPickerPreference app:defaultValue="9" app:title="@string/qmobile_color" app:key="appTheme" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:key="qmobileSurfaceTheme" app:title="@string/theme" app:persistent="false" app:entries="@array/qmobile_surface_themes" app:entryValues="@array/qmobile_surface_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:key="seasonal_decoration" app:title="@string/qmobile_seasonal" app:defaultValue="halloween" app:entries="@array/qmobile_seasons" app:entryValues="@array/qmobile_season_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="" app:entries="@array/language_entries" app:entryValues="@array/language_values" app:key="appLanguage" app:title="@string/language" app:useSimpleSummaryProvider="true" />
 </PreferenceCategory>
 <PreferenceCategory app:title="@string/cag_notification">
  <SwitchPreference app:defaultValue="false" app:key="qmobileNotificationSpeed" app:title="@string/qmobile_notification_speed" />
 </PreferenceCategory>
</PreferenceScreen>
