<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp">
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/backup_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/backup_tab_local">
        <com.google.android.material.button.MaterialButton android:id="@+id/backup_tab_local" style="@style/Widget.SagerNet.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Локально" app:cornerRadius="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/backup_tab_webdav" style="@style/Widget.SagerNet.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WebDAV" app:cornerRadius="20dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="0dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:id="@+id/backup_local_page" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/backup_local" android:textAppearance="?attr/textAppearanceHeadline6" />
                    <CheckBox android:id="@+id/backup_profiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:checked="true" android:text="@string/backup_part_profiles" android:minHeight="44dp" android:textSize="14sp" />
                    <CheckBox android:id="@+id/backup_routes" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/backup_part_routes" android:minHeight="44dp" android:textSize="14sp" />
                    <CheckBox android:id="@+id/backup_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/backup_part_settings" android:minHeight="44dp" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/backup_local_summary" android:textAppearance="?attr/textAppearanceBody2" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                    <Button android:id="@+id/backup_create" style="@style/Widget.SagerNet.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/backup_create" android:textColor="?whiteOrTextPrimary" app:cornerRadius="24dp" android:textSize="14sp" android:minHeight="48dp" android:maxLines="3" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/backup_share" style="@style/Widget.SagerNet.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/share" app:cornerRadius="24dp" android:textSize="14sp" android:minHeight="48dp" android:maxLines="3" />
                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />
                        <Button android:id="@+id/backup_restore" style="@style/Widget.SagerNet.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/backup_restore" app:cornerRadius="24dp" android:textSize="14sp" android:minHeight="48dp" android:maxLines="3" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="0dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:id="@+id/backup_webdav_page" android:layout_marginTop="12dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/backup_webdav" android:textAppearance="?attr/textAppearanceHeadline6" />
                    <Button android:id="@+id/backup_to_webdav" style="@style/Widget.SagerNet.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/backup_to_webdav" android:textColor="?whiteOrTextPrimary" app:cornerRadius="24dp" android:textSize="14sp" android:minHeight="48dp" android:maxLines="3" />
                    <Button android:id="@+id/restore_from_webdav" style="@style/Widget.SagerNet.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/restore_from_webdav" app:cornerRadius="24dp" android:textSize="14sp" android:minHeight="48dp" android:maxLines="3" />
                    <Button android:id="@+id/webdav_settings" style="@style/Widget.SagerNet.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/webdav_settings" app:cornerRadius="24dp" android:textSize="14sp" android:minHeight="48dp" android:maxLines="3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/reset_settings" style="@style/Widget.SagerNet.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/reset_settings" app:cornerRadius="24dp" android:layout_marginBottom="8dp" android:textSize="14sp" android:maxLines="3" />
</LinearLayout>